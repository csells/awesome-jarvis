#!/bin/bash
# lab shim: `uwsm-app [-opts] -- cmd…` normally asks the systemd --user app daemon
# to start cmd in its own scope/slice. No systemd user session in a container:
# start cmd directly, detached.
while [ $# -gt 0 ]; do case "$1" in --) shift; break;; -*) [ "$1" = -s ] || [ "$1" = -a ] || [ "$1" = -u ] && shift; shift;; *) break;; esac; done
[ $# -gt 0 ] || exit 0
exec setsid "$@"
