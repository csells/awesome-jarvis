+import { it, expect } from 'vitest';
+import { AbstractAgent, EventType, type RunAgentInput } from '@ag-ui/client';
+import { InMemoryAgentRunner } from '@copilotkit/runtime/v2';
+import { of, lastValueFrom, toArray } from 'rxjs';
+import { Store } from '../src/server/store.js';
+import { LocalRunner } from '../src/server/local-runner.js';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+class Agent extends AbstractAgent {
+  run(input: RunAgentInput) {
+    return of(
+      {
+        type: EventType.RUN_STARTED,
+        threadId: input.threadId,
+        runId: input.runId,
+      },
+      {
+        type: EventType.TEXT_MESSAGE_START,
+        messageId: input.runId + '-answer',
+        role: 'assistant' as const,
+      },
+      {
+        type: EventType.TEXT_MESSAGE_CONTENT,
+        messageId: input.runId + '-answer',
+        delta: 'Saved eleven pages.',
+      },
+      { type: EventType.TEXT_MESSAGE_END, messageId: input.runId + '-answer' },
+      { type: EventType.STATE_SNAPSHOT, snapshot: { count: 11 } },
+      {
+        type: EventType.RUN_FINISHED,
+        threadId: input.threadId,
+        runId: input.runId,
+      },
+    );
+  }
+}
+it('restores messages, state and connection snapshots after restarting and continues without duplicates', async () => {
+  const dir = mkdtempSync(join(tmpdir(), 'opendots-runner-'));
+  let store = new Store(join(dir, 'test.sqlite'));
+  try {
+    new InMemoryAgentRunner().clearThreads();
+    let runner = new LocalRunner(store);
+    const input = {
+      threadId: 'persistent-test',
+      runId: 'first',
+      messages: [
+        { id: 'request', role: 'user' as const, content: 'Save eleven pages.' },
+      ],
+      state: {},
+      tools: [],
+      context: [],
+      forwardedProps: {},
+    };
+    await lastValueFrom(
+      runner
+        .run({ threadId: input.threadId, agent: new Agent(), input })
+        .pipe(toArray()),
+    );
+    const messages = runner.getThreadMessages(input.threadId);
+    expect(messages).toHaveLength(2);
+    store.close();
+    new InMemoryAgentRunner().clearThreads();
+    store = new Store(join(dir, 'test.sqlite'));
+    runner = new LocalRunner(store);
+    expect(runner.getThreadMessages(input.threadId)).toEqual(messages);
+    expect(runner.getThreadState(input.threadId)).toEqual({ count: 11 });
+    const replay = await lastValueFrom(
+      runner.connect({ threadId: input.threadId }).pipe(toArray()),
+    );
+    expect(replay).toContainEqual({
+      type: EventType.MESSAGES_SNAPSHOT,
+      messages,
+    });
+    const next = {
+      ...input,
+      runId: 'second',
+      messages: [
+        ...messages,
+        { id: 'next', role: 'user' as const, content: 'Continue' },
+      ],
+    };
+    await lastValueFrom(
+      runner
+        .run({ threadId: input.threadId, agent: new Agent(), input: next })
+        .pipe(toArray()),
+    );
+    expect(runner.getThreadMessages(input.threadId)).toHaveLength(4);
+    expect(runner.listThreads().map((t) => t.id)).toContain(input.threadId);
+  } finally {
+    store.close();
+    rmSync(dir, { recursive: true });
+    new InMemoryAgentRunner().clearThreads();
+  }
+});
+
+it('persists a completed turn even when its HTTP consumer disconnects', async () => {
+  const { delay } = await import('rxjs');
+  class SlowAgent extends Agent {
+    override run(input: RunAgentInput) {
+      return super.run(input).pipe(delay(60));
+    }
+  }
+  const store = new Store(':memory:');
+  try {
+    new InMemoryAgentRunner().clearThreads();
+    const runner = new LocalRunner(store);
+    const input = {
+      threadId: 'disconnect-test',
+      runId: 'run',
+      messages: [{ id: 'user', role: 'user' as const, content: 'Save' }],
+      state: {},
+      tools: [],
+      context: [],
+      forwardedProps: {},
+    };
+    const sub = runner
+      .run({ threadId: input.threadId, agent: new SlowAgent(), input })
+      .subscribe();
+    sub.unsubscribe();
+    await new Promise((r) => setTimeout(r, 150));
+    expect(runner.getThreadMessages(input.threadId)).toHaveLength(2);
+    new InMemoryAgentRunner().clearThreads();
+    expect(
+      new LocalRunner(store).getThreadMessages(input.threadId),
+    ).toHaveLength(2);
+  } finally {
+    store.close();
+    new InMemoryAgentRunner().clearThreads();
+  }
+});
+
+it('connects to live events during the first unfinished run', async () => {
+  const { delay } = await import('rxjs');
+  class SlowAgent extends Agent {
+    override run(input: RunAgentInput) {
+      return super.run(input).pipe(delay(60));
+    }
+  }
+  const store = new Store(':memory:');
+  try {
+    new InMemoryAgentRunner().clearThreads();
+    const runner = new LocalRunner(store);
+    const input = {
+      threadId: 'connect-test',
+      runId: 'run',
+      messages: [],
+      state: {},
+      tools: [],
+      context: [],
+      forwardedProps: {},
+    };
+    const completed = lastValueFrom(
+      runner
+        .run({ threadId: input.threadId, agent: new SlowAgent(), input })
+        .pipe(toArray()),
+    );
+    const replay = await lastValueFrom(
+      runner.connect({ threadId: input.threadId }).pipe(toArray()),
+    );
+    await completed;
+    expect(replay.some((e) => e.type === EventType.RUN_FINISHED)).toBe(true);
+  } finally {
+    store.close();
+    new InMemoryAgentRunner().clearThreads();
+  }
+});
+
+it('applies a state delta to the restored snapshot after restart', async () => {
+  class DeltaAgent extends AbstractAgent {
+    run(input: RunAgentInput) {
+      return of(
+        {
+          type: EventType.RUN_STARTED,
+          threadId: input.threadId,
+          runId: input.runId,
+        },
+        {
+          type: EventType.STATE_DELTA,
+          delta: [{ op: 'replace', path: '/count', value: 12 }],
+        },
+        {
+          type: EventType.RUN_FINISHED,
+          threadId: input.threadId,
+          runId: input.runId,
+        },
+      );
+    }
+  }
+  const store = new Store(':memory:');
+  try {
+    new InMemoryAgentRunner().clearThreads();
+    let runner = new LocalRunner(store);
+    const input = {
+      threadId: 'delta-test',
+      runId: 'first',
+      messages: [],
+      state: {},
+      tools: [],
+      context: [],
+      forwardedProps: {},
+    };
+    await lastValueFrom(
+      runner
+        .run({ threadId: input.threadId, agent: new Agent(), input })
+        .pipe(toArray()),
+    );
+    new InMemoryAgentRunner().clearThreads();
+    runner = new LocalRunner(store);
+    await lastValueFrom(
+      runner
+        .run({
+          threadId: input.threadId,
+          agent: new DeltaAgent(),
+          input: { ...input, runId: 'second' },
+        })
+        .pipe(toArray()),
+    );
+    expect(runner.getThreadState(input.threadId)).toEqual({ count: 12 });
+    new InMemoryAgentRunner().clearThreads();
+    expect(new LocalRunner(store).getThreadState(input.threadId)).toEqual({
+      count: 12,
+    });
+  } finally {
+    store.close();
+    new InMemoryAgentRunner().clearThreads();
+  }
+});
