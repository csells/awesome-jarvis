#!/bin/bash
# jarvis-lab shim: `journalctl --user -u UNIT [-f] [-n N]` -> tail the shim's log file.
u=voice-launcher.service n=50 f=""
while [ $# -gt 0 ]; do case "$1" in -u) u=$2; shift 2;; -n) n=$2; shift 2;; -f) f=-f; shift;; *) shift;; esac; done
[[ "$u" == *.* ]] || u="$u.service"
exec tail -n "$n" $f "/tmp/lab-logs/$u.log"
