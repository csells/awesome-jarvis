+export async function voiceCompute(
+  compute: () => Promise<{ text: string }>,
+  refresh: () => Promise<void>,
+  refreshFailed: (error: unknown) => void,
+) {
+  const result = await compute();
+  try {
+    await refresh();
+  } catch (error) {
+    refreshFailed(error);
+  }
+  return result.text;
+}
