@@ -0,0 +1,34 @@
+import { AbstractAgent, EventType, type RunAgentInput } from '@ag-ui/client';
+import { of } from 'rxjs';
+
+// A receipt persists the supplied transcript. It must not dispatch tools or
+// invent decisions from generated speech that may never have been played.
+export class LocalReceiptAgent extends AbstractAgent {
+  run(input: RunAgentInput) {
+    const messageId = `${input.runId}:receipt`;
+    return of(
+      {
+        type: EventType.RUN_STARTED,
+        threadId: input.threadId,
+        runId: input.runId,
+      },
+      {
+        type: EventType.TEXT_MESSAGE_START,
+        messageId,
+        role: 'assistant' as const,
+      },
+      {
+        type: EventType.TEXT_MESSAGE_CONTENT,
+        messageId,
+        delta:
+          'Call ended. Transcript saved for this conversation; generated speech may have been interrupted.',
+      },
+      { type: EventType.TEXT_MESSAGE_END, messageId },
+      {
+        type: EventType.RUN_FINISHED,
+        threadId: input.threadId,
+        runId: input.runId,
+      },
+    );
+  }
+}
diff --git a/src/server/local-runner.ts b/src/server/local-runner.ts
new file mode 100644
index 0000000..9a71116
--- /dev/null
+++ b/src/server/local-runner.ts
@@ -0,0 +1,121 @@
+import {
+  InMemoryAgentRunner,
+  type AgentRunnerRunRequest,
+  type AgentRunnerConnectRequest,
+} from '@copilotkit/runtime/v2';
+import { EventType, type Message, type BaseEvent } from '@ag-ui/client';
+import { of, tap, ReplaySubject, defer, switchMap, concatMap } from 'rxjs';
+import type { Store } from './store.js';
+type Thread = ReturnType<InMemoryAgentRunner['listThreads']>[number];
+interface Snapshot {
+  messages: Message[];
+  state: Record<string, unknown> | null;
+  thread: Thread;
+}
+// Keep the SDK's streaming/cancellation behavior; persist completed runs in the
+// application's SQLite DB. No private SDK store APIs or replayed tool execution.
+export class LocalRunner extends InMemoryAgentRunner {
+  constructor(private store: Store) {
+    super();
+  }
+  private snapshot(id: string): Snapshot | undefined {
+    const value = this.store.localThread(id);
+    return value ? (JSON.parse(value) as Snapshot) : undefined;
+  }
+  override run(request: AgentRunnerRunRequest) {
+    const prior = this.getThreadMessages(request.threadId);
+    const messages = [
+      ...new Map(
+        [...prior, ...request.input.messages].map((m) => [m.id, m]),
+      ).values(),
+    ];
+    const state = {
+      ...this.getThreadState(request.threadId),
+      ...request.input.state,
+    };
+    request.agent.messages = messages;
+    request.agent.state = state;
+    const originalRun = request.agent.run;
+    // A restored state must also seed the SDK's per-run event compactor;
+    // otherwise a later JSON Patch replace targets an empty object.
+    request.agent.run = function (input) {
+      return originalRun
+        .call(this, input)
+        .pipe(
+          concatMap((event) =>
+            event.type === EventType.RUN_STARTED
+              ? of(event, { type: EventType.STATE_SNAPSHOT, snapshot: state })
+              : of(event),
+          ),
+        );
+    };
+    const output = new ReplaySubject<BaseEvent>();
+    super
+      .run({ ...request, input: { ...request.input, messages, state } })
+      .pipe(
+        tap({
+          complete: () => {
+            request.agent.run = originalRun;
+            const thread = super
+              .listThreads()
+              .find((t) => t.id === request.threadId);
+            if (!thread)
+              throw new Error('Local runtime did not finalize its thread.');
+            this.store.saveLocalThread(
+              request.threadId,
+              JSON.stringify({
+                messages: super.getThreadMessages(request.threadId),
+                state: super.getThreadState(request.threadId),
+                thread,
+              } satisfies Snapshot),
+            );
+          },
+        }),
+      )
+      .subscribe(output);
+    return output.asObservable();
+  }
+  override getThreadMessages(id: string) {
+    const live = super.getThreadMessages(id);
+    return live.length ? live : (this.snapshot(id)?.messages ?? []);
+  }
+  override getThreadState(id: string) {
+    return super.getThreadState(id) ?? this.snapshot(id)?.state ?? null;
+  }
+  override listThreads() {
+    return [
+      ...new Map(
+        [
+          ...this.store
+            .localThreads()
+            .map((s) => (JSON.parse(s) as Snapshot).thread),
+          ...super.listThreads(),
+        ].map((t) => [t.id, t]),
+      ).values(),
+    ];
+  }
+  override getThreadEvents(id: string): BaseEvent[] {
+    const live = super.getThreadEvents(id);
+    if (live.length) return live;
+    const saved = this.snapshot(id);
+    return saved
+      ? [
+          { type: EventType.MESSAGES_SNAPSHOT, messages: saved.messages },
+          { type: EventType.STATE_SNAPSHOT, snapshot: saved.state ?? {} },
+        ]
+      : [];
+  }
+  override connect(request: AgentRunnerConnectRequest) {
+    return defer(() => super.isRunning(request)).pipe(
+      switchMap((running) =>
+        running || super.listThreads().some((t) => t.id === request.threadId)
+          ? super.connect(request)
+          : of(...this.getThreadEvents(request.threadId)),
+      ),
+    );
+  }
+  override clearThreads() {
+    super.clearThreads();
+    this.store.clearLocalThreads();
+  }
+}
