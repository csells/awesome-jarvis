#!/bin/bash
# lab shim: `systemd-cat -t TAG -- cmd…` -> run cmd with output appended to /tmp/lab-logs/TAG.log (no journald).
tag=systemd-cat
while [ $# -gt 0 ]; do case "$1" in -t) tag=$2; shift 2;; --identifier=*) tag=${1#*=}; shift;; --) shift; break;; -*) shift;; *) break;; esac; done
mkdir -p /tmp/lab-logs
[ $# -eq 0 ] && exec cat >>"/tmp/lab-logs/$tag.log"
exec "$@" >>"/tmp/lab-logs/$tag.log" 2>&1
