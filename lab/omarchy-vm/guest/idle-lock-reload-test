#!/bin/bash
# idle-lock-reload-test [outdir] — reproduce the Docker/sway finding on real Hyprland:
# let Omarchy's idle service lock the session (lock=300 s), then trigger plugin reloads while locked
# and check whether omarchy-shell (quickshell) survives. Needs stay-awake OFF; restores it at the end.
set -u
eval "$("$HOME/.local/share/jarvis-lab/bin/hyprenv")"
OUT=${1:-$HOME/idle-lock-test}; mkdir -p "$OUT"
P=$HOME/.config/omarchy/plugins/atzingen.jarvis
qs() { pgrep -f "quickshell -n -p /usr/share/omarchy/shell" | head -1; }
ping_() { timeout 5 omarchy-shell shell ping >/dev/null 2>&1 && echo ok || echo "NO-IPC"; }
state() { echo "[$(date +%T)] $1: qs_pid=$(qs) ipc=$(ping_) locked=$(timeout 5 omarchy-shell lock isLocked 2>/dev/null) dpms=$(hyprctl monitors -j | jq -r '.[0].dpmsStatus')"; }
since=$(date '+%Y-%m-%d %H:%M:%S')
pid0=$(qs)
state "baseline"
omarchy toggle idle allow-idle >/dev/null; echo "stay-awake: $(omarchy-toggle-idle --status)"
echo "waiting for the idle lock (Omarchy: screensaver 150 s, lock 300 s)..."
for i in $(seq 480); do [ "$(timeout 5 omarchy-shell lock isLocked 2>/dev/null)" = true ] && break; sleep 1; done
state "idle-locked after ${i}s"
sleep 10
state "locked+10s"
echo "== reload 1: file change in the plugin dir (PluginRegistry's inotifywait -> hot reload)"
touch "$P/BarWidget.qml"; printf '\n' >> "$P/manifest.json"; git -C "$P" checkout -q -- manifest.json
sleep 8; state "after reload 1"
echo "== reload 2: omarchy-shell shell rescanPlugins"
timeout 10 omarchy-shell shell rescanPlugins; sleep 8; state "after reload 2"
echo "== reload 3: omarchy plugin disable + enable atzingen.jarvis"
timeout 20 omarchy plugin disable atzingen.jarvis; sleep 4; timeout 20 omarchy plugin enable atzingen.jarvis --section right --index 1; sleep 8
state "after reload 3"
echo "== reload 4: git checkout of the plugin (what the Docker smoketest did while the session was locked)"
git -C "$P" -c advice.detachedHead=false checkout -q "$(git -C "$P" rev-parse HEAD)"; git -C "$P" stash list >/dev/null
touch "$P"/app/qs/*.qml; sleep 10; state "after reload 4"
pid1=$(qs)
echo "== verdict: omarchy-shell pid before=$pid0 after=$pid1 -> $([ "$pid0" = "$pid1" ] && echo 'SURVIVED (same process)' || echo 'RESTARTED/CRASHED')"
echo "== omarchy-shell journal since start (errors / crash / lock / plugin)"
journalctl --user --since "$since" --no-pager -o short-precise | grep -iE "omarchy-shell|quickshell|crash|segfault|abort|core dump" | grep -iE "error|warn|crash|segfault|abort|dump|lock|plugin|reload" | grep -v "omarchy idle.*process-" | cut -c1-230 | tail -40
echo "== coredumps"; coredumpctl list --since "$since" --no-pager 2>&1 | tail -5
timeout 10 grim "$OUT/locked-after-reloads.png" && echo "screenshot: $OUT/locked-after-reloads.png" || echo "grim timed out (display blanked by the lock's DPMS-off)"
