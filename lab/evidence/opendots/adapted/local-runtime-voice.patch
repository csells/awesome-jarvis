diff --git a/src/client/local-history.ts b/src/client/local-history.ts
new file mode 100644
index 0000000..2faf48d
--- /dev/null
+++ b/src/client/local-history.ts
@@ -0,0 +1,25 @@
+import { MessageSchema } from '@ag-ui/core';
+export interface RuntimeMessage {
+  id: string;
+  role: string;
+  content?: string;
+  toolCallId?: string;
+  toolCalls?: { id: string; name: string; args: string }[];
+}
+// The runtime REST endpoint uses flat tool calls; the AG-UI client uses function objects.
+export function localHistoryMessages(messages: RuntimeMessage[]) {
+  return messages.map(({ toolCalls, ...message }) =>
+    MessageSchema.parse({
+      ...message,
+      ...(toolCalls
+        ? {
+            toolCalls: toolCalls.map((call) => ({
+              id: call.id,
+              type: 'function',
+              function: { name: call.name, arguments: call.args },
+            })),
+          }
+        : {}),
+    }),
+  );
+}
diff --git a/tests/local-history.test.ts b/tests/local-history.test.ts
new file mode 100644
index 0000000..5d61e14
--- /dev/null
+++ b/tests/local-history.test.ts
@@ -0,0 +1,35 @@
+import { expect, it } from 'vitest';
+import { localHistoryMessages } from '../src/client/local-history';
+it('restores REST tool calls to AG-UI format without replaying or duplicating arguments', () => {
+  const args = '{"title":"Voice page","content":"Eleven pages"}';
+  const snapshot = [
+    { id: 'user', role: 'user', content: 'Create a page' },
+    {
+      id: 'answer',
+      role: 'assistant',
+      content: 'Saved',
+      toolCalls: [{ id: 'call', name: 'create_space_page', args }],
+    },
+    {
+      id: 'result',
+      role: 'tool',
+      toolCallId: 'call',
+      content: '{"id":"page"}',
+    },
+  ];
+  const restored = localHistoryMessages(snapshot);
+  expect(restored[1]).toEqual({
+    id: 'answer',
+    role: 'assistant',
+    content: 'Saved',
+    toolCalls: [
+      {
+        id: 'call',
+        type: 'function',
+        function: { name: 'create_space_page', arguments: args },
+      },
+    ],
+  });
+  expect(localHistoryMessages(snapshot)).toEqual(restored);
+  expect(restored[2]).toEqual(snapshot[2]);
+});
