+import { expect, it, vi } from 'vitest';
+import { voiceCompute } from '../src/client/voice-compute';
+it('returns a successful tool result despite UI refresh failure without retrying the write', async () => {
+  const compute = vi.fn(async () => ({ text: 'Created page 123' }));
+  const failed = vi.fn();
+  const error = new Error('history offline');
+  expect(
+    await voiceCompute(
+      compute,
+      async () => {
+        throw error;
+      },
+      failed,
+    ),
+  ).toBe('Created page 123');
+  expect(compute).toHaveBeenCalledTimes(1);
+  expect(failed).toHaveBeenCalledWith(error);
+});
